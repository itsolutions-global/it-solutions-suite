    { "source": "/solutions", "destination": "/company/growth/portal/solutions.html" },
    { "source": "/msme-43bh-calculator.html", "destination": "/company/growth/portal/msme-43bh-calculator.html" },
    { "source": "/msme-43bh-calculator", "destination": "/company/growth/portal/msme-43bh-calculator.html" },
    { "source": "/uk-late-payment-calculator.html", "destination": "/company/growth/portal/uk-late-payment-calculator.html" },
    { "source": "/uk-late-payment-calculator", "destination": "/company/growth/portal/uk-late-payment-calculator.html" },
    { "source": "/sbom-generator.html", "destination": "/company/growth/portal/sbom-generator.html" },
