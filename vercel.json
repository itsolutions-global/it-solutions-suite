    { "source": "/app.js", "destination": "/company/growth/portal/app.js" },
    { "source": "/feedback.js", "destination": "/company/growth/portal/feedback.js" },
    { "source": "/feedback.css", "destination": "/company/growth/portal/feedback.css" },
    { "source": "/sitemap.xml", "destination": "/company/growth/portal/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/company/growth/portal/robots.txt" },
    { "source": "/api/(.*)", "destination": "/company/growth/portal/api/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/github",
      "destination": "https://github.com/itsolutions-global/it-solutions-suite",
      "permanent": false
    },
    {
      "source": "/pypi",
      "destination": "https://pypi.org/project/it-solutions-suite",
      "permanent": false
    }
  ]
}
